<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF8FF"
    android:padding="30dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Almost there!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1268A8"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="One last detail to calculate your water goal."
        android:textSize="15sp"
        android:textColor="#5F7180"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What's your weight?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp" />

    <EditText
        android:id="@+id/etweightInput"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Weight in kg"
        android:inputType="numberDecimal"
        android:padding="15dp"
        android:backgroundTint="#1479C9"
        android:layout_marginTop="25dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Example: 65 kg"
        android:textSize="14sp"
        android:textColor="#5F7180"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="SAVE And CONTINUE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#1479C9" />

</LinearLayout>